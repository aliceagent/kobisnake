{
  "name": "kobisnake",
  "version": "0.1.0",
  "private": true,
  "description": "KOBI Snake — a local two-player 3D Snake game for the desktop browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:unit": "vitest run --coverage.enabled=false",
    "test:coverage": "COVERAGE_STRICT=1 vitest run tests/unit tests/agent",
    "test:e2e": "node scripts/run-playwright-suite.mjs e2e tests/e2e --project=chromium",
    "test:visual": "node scripts/run-playwright-suite.mjs visual tests/visual --project=chromium",
    "test:agent": "node scripts/run-playwright-suite.mjs agent tests/agent --project=chromium",
    "test:agent:report": "node scripts/run-playwright-suite.mjs agent-report tests/agent/report.spec.js --project=chromium",
    "test:agent:pacing": "node scripts/run-playwright-suite.mjs agent-pacing tests/agent/pacing.spec.js --project=chromium",
    "test:agent:viewports": "node scripts/run-playwright-suite.mjs agent-viewports tests/agent/viewports.spec.js --project=chromium",
    "test:agent:monkey": "node scripts/run-playwright-suite.mjs agent-monkey tests/agent/monkey.spec.js --project=chromium",
    "test:perf": "npm run test:perf:bundle && npm run test:perf:drawcalls",
    "test:perf:bundle": "vitest run tests/perf/bundle.test.js --coverage.enabled=false",
    "test:perf:drawcalls": "node scripts/run-playwright-suite.mjs perf-drawcalls tests/perf/drawCalls.spec.js --project=chromium",
    "test:perf:frametime": "node scripts/run-playwright-suite.mjs perf-frametime tests/perf/frameTime.spec.js --project=chromium",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "5.4.21",
    "vitest": "3.2.4"
  }
}
