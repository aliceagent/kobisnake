{
  "name": "kobisnake",
  "version": "0.1.0",
  "private": true,
  "description": "KOBI Snake — a local two-player 3D Snake game for the desktop browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.4"
  }
}
