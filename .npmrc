# KI-19-01 — install-time settings that keep the dependency set honest.
#
# Both of these encode a rule this repository already follows by hand, so that following it stops depending on
# whoever runs the command remembering to.

# Every dependency in package.json is pinned to an exact version, deliberately: `ARCHITECTURE §12`'s bundle
# budget and `tests/visual/__baselines__` both assume the build is reproducible, and a caret range makes the
# bytes that ship a function of the day someone ran `npm install`. Without this, `npm install <pkg>` writes
# `^1.2.3` and quietly reintroduces that. With it, a range can still be written by hand — the point is that the
# default is the safe one.
save-exact=true

# package.json declares `engines.node >= 20` and `.nvmrc` pins 20. Without this, npm treats that as advice and
# a mismatched Node installs anyway, producing a lockfile and a `dist/` from a toolchain nobody chose.
#
# Verified on Node 20 before landing, because this setting can in principle refuse a *transitive* package too
# and CI runs Node 20 while the dev containers run 22 — a bad guess here would have reddened every job, not
# just this ticket's. Three runs of `npm ci` against this exact lockfile:
#
#   Node 20.20.2, engine-strict=true, engines >=20   -> exit 0, 336 packages
#   Node 20.20.2, engine-strict=true, engines >=99   -> exit 1, "Not compatible with your version of node"
#   Node 20.20.2, engine-strict absent,  engines >=99 -> exit 0, installs silently
#
# So it enforces the declaration this repository actually makes, it is not decorative, and it does not trip
# over `@napi-rs/lzma-linux-x64-gnu` (reached via vite -> rollup), whose own `engines.node` excludes 20.
engine-strict=true
